{
  "name": "@netiflyjs/react",
  "version": "0.1.0",
  "description": "React provider and hooks (useNetifly, useEvent, useNotifications) for Netifly — StrictMode-safe, SSR-safe.",
  "keywords": [
    "netifly",
    "react",
    "hooks",
    "notifications",
    "realtime",
    "websocket",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NetiflyJS/netifly.git",
    "directory": "packages/react"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && jest && tsd",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@netiflyjs/client": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-jest": "^29.2.2",
    "tsd": "^0.33.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
